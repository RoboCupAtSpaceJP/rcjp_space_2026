<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="analog_camera">
    <static>false</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://96-camara-analogica_byquuimey/Camara_Analogica.obj</uri>
          </mesh>
        </geometry>
        <transparency>0</transparency>
